{
  "name": "rpg-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "echo 'Wave-2 CLI entry point not yet implemented. See src/cli/ when ready.'",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests --max-warnings 0",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "check": "npm run type-check && npm run lint && npm run test"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.1.0",
    "ai": "^4.1.0",
    "better-sqlite3": "^11.7.0",
    "js-yaml": "^4.1.1",
    "ollama-ai-provider": "^1.2.0",
    "sqlite-vec": "^0.1.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  }
}
